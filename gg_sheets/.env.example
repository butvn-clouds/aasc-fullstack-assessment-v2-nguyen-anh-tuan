NODE_ENV=production
PORT=3000

# Google Sheets
# Auth mode: "service_account" (default) or "oauth"
GOOGLE_AUTH_MODE=service_account

# Used when GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Used when GOOGLE_AUTH_MODE=oauth (see scripts/get-oauth-refresh-token.js)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SHEET_ID=-n07OaEtM
GOOGLE_SHEET_WORKSHEET_NAME=leads

# Bitrix24
BITRIX24_WEBHOOK_URL=

# Sync
SYNC_CRON=*/15 * * * *
SYNC_BATCH_SIZE=20
SYNC_BITRIX_CONCURRENCY=2
SYNC_DIRECTION=both
NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=
# Số lần retry 0..10, dùng chung Google/Bitrix. Không replay batch sau timeout.
SYNC_MAX_RETRIES=4
SYNC_RETRY_BASE_DELAY_MS=500
# Chỉ áp dụng cho reverse và forward khi SYNC_DIRECTION=both.
# Two-way sync (bonus feature): "bitrix_wins" (default) or "sheet_wins"
CONFLICT_RESOLUTION_STRATEGY=bitrix_wins

# Security
MANAGEMENT_API_KEY=
BITRIX24_WEBHOOK_SECRET=

# Authtoken tai khoan ngrok, khac token webhook Bitrix.
# --- Bảo mật & vận hành ---
# Swagger (/docs) mặc định TẮT khi NODE_ENV=production; đặt true để bật tạm thời khi cần.
ENABLE_SWAGGER=true
# Số proxy tin cậy phía trước (vd. 1 khi sau nginx/Cloudflare) để rate limit dùng IP thật. Để trống nếu không có proxy.
TRUST_PROXY=
# Khóa liên tiến trình (server + CLI + container dùng chung volume ./data). Tắt bằng false (không khuyến nghị).
SYNC_FILE_LOCK=true
# Khóa không được gia hạn quá số ms này sẽ bị coi là của tiến trình đã chết (mặc định 10 phút).
SYNC_LOCK_TTL_MS=600000
# Webhook Bitrix chạy nền: chờ (ms) trước khi thử lại một sự kiện lỗi; tối đa 3 lần.
WEBHOOK_RETRY_DELAY_MS=2000

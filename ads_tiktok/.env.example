NODE_ENV=development
PORT=3000
# Bảo vệ /api và /mock bằng header X-API-Key; để trống chỉ dành cho demo local.
# NODE_ENV=production sẽ từ chối khởi động nếu thiếu ADMIN_API_KEY/TIKTOK_WEBHOOK_SECRET (>= 16 ký tự).
ADMIN_API_KEY=
SESSION_TTL_SECONDS=3600

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=leads
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

REDIS_HOST=localhost
REDIS_PORT=6379
# Để trống nếu Redis không đặt mật khẩu (dev). Production nên đặt.
REDIS_PASSWORD=

# HMAC secret dùng xác thực header TikTok-Signature
# Tự sinh demo: trống/change-me sẽ dùng secret tạm trong lần chạy app.
TIKTOK_WEBHOOK_SECRET=change-me
TIKTOK_SIGNATURE_TOLERANCE_SEC=300
# Chế độ thật cần đủ URL HTTPS và access token; thiếu cấu hình sẽ báo lỗi.
# Chỉ giả lập conversion khi bật rõ ràng; trạng thái kết quả là mocked.
TIKTOK_EVENTS_MOCK=true
TIKTOK_EVENTS_API_URL=
TIKTOK_ACCESS_TOKEN=

# Bật true để dùng Bitrix24 mock cho demo; dữ liệu và ID mock lưu trong PostgreSQL.
BITRIX24_MOCK=false
# Tự sinh 5–10 lead TikTok demo mỗi chu kỳ; lead đi vào CRM theo BITRIX24_MOCK.
# Dùng khi chưa có tài khoản TikTok thật: app tự gửi webhook có chữ ký vào chính nó.
# Cảnh báo: khi BITRIX24_MOCK=false, lead [DEMO] sẽ được tạo trong Bitrix24 thật,
# nên phải đặt thêm MOCK_LEADS_ALLOW_REAL_CRM=true để xác nhận; thiếu thì app không khởi động.
MOCK_LEADS_ENABLED=false
MOCK_LEADS_ALLOW_REAL_CRM=false
MOCK_LEADS_INTERVAL_MINUTES=15
# Giới hạn mỗi lần chạy app (mỗi instance); bộ đếm reset khi khởi động lại.
MOCK_LEADS_MAX_TOTAL=1000
# Khi BITRIX24_MOCK=false, cần URL REST HTTPS thật của Bitrix24 (kết thúc bằng dấu /).
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/1/your-inbound-webhook/
# application_token của outbound webhook Bitrix24
BITRIX24_APP_TOKEN=change-me

DEFAULT_PHONE_REGION=VN
NOTIFY_WEBHOOK_URL=
REPORT_ALERT_MIN_CONVERSION=0.05
# Gửi báo cáo Excel hằng ngày lúc 08:00 Asia/Bangkok. Để trống để tắt.
# Bên nhận chấp nhận multipart/form-data với các trường file, report_id, date_range.
REPORT_WEBHOOK_URL=
REPORT_WEBHOOK_TOKEN=

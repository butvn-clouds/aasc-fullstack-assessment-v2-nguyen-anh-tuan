# Dùng với: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Sinh secret: openssl rand -hex 32
DB_USER=postgres
DB_PASSWORD=
DB_NAME=leads
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
REDIS_PASSWORD=
ADMIN_API_KEY=

# Chỉ giả lập conversion khi bật rõ ràng; trạng thái kết quả là mocked.
TIKTOK_EVENTS_MOCK=false
TIKTOK_EVENTS_API_URL=
TIKTOK_ACCESS_TOKEN=
BITRIX24_MOCK=false
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/1/xxxxxxxx/
